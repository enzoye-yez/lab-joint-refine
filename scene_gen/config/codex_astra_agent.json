{
  "provider": "codex",
  "base_url": "https://chatgpt.com/backend-api/codex",
  "model": "gpt-6-astra",
  "search_provider": "model_web",
  "scope": "From the complete input experimental protocol, extract the instruments, containers, consumables and necessary accessories together with their requirements; reagents are not assets to be generated. Do not presuppose the experiment type, the final step, or any excluded experimental stage.",
  "chunk_chars": 4000,
  "max_document_chars": 1000000,
  "max_input_bytes": 160000,
  "max_assets": 64,
  "max_output_tokens": 12000,
  "extraction_max_assets": 8,
  "extraction_max_chars": 16000,
  "extraction_output_tokens": 6000,
  "output_token_parameter": "max_completion_tokens",
  "repair_attempts": 2,
  "queries_per_asset": 2,
  "results_per_query": 5,
  "images_per_asset": 2,
  "timeout_seconds": 3600,
  "max_model_calls": 40,
  "max_search_calls": 64,
  "search_max_output_tokens": 2048,
  "search_context_reserve_tokens": 16000,
  "search_max_tool_calls": 1,
  "pages_per_asset": 3,
  "max_page_fetches": 192,
  "max_image_downloads": 128,
  "max_reserved_tokens": 1200000,
  "download_images": true,
  "api_key_env": "CODEX_LOGIN",
  "codex_agent_author": true
}
