  "assumptions": [
    "五支移液器按资料给定量程建模；外形、孔距、壁厚和内部弹簧尺寸为建模假设。",
    "吸头盒按96孔、8行12列建模，孔距和开口形状为建模假设。",
    "每支移液器初始带一支独立吸头；盒内另有96支未使用吸头，作为独立可拆对象。"
  ],
  "approximations": [
    "旋钮、一级/二级按压和弹射用转动关节及两级滑动关节刚体近似。",
    "吸头锥体采用圆柱加圆锥分段刚体近似，未模拟柔性薄壁。"
  ],
